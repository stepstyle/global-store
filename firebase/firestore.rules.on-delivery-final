rules_version = '2';
// FINAL rules for STOCK_POLICY=on_delivery = firestore.rules.on-delivery (live since 2026-11-19) with the orders
// collection closed to direct browser writes and reads:
//   - create: NEVER from a browser (admin included). Orders are written only by the order Worker v2 (and, while it is
//     still running, Worker v1) with their service accounts, which are not subject to these rules. This closes fake
//     orders that skip the Worker's Turnstile, price check, stock reservation and Telegram notice.
//   - get / list: the admins, or the signed-in customer the order belongs to (userId == uid). A guest reads their order
//     only through the Worker (order number + tracking key, a summary without personal data). Before: anyone holding
//     an order number could read the name, phone and address.
//   - update / delete: unchanged (Worker-managed orders: status and stock only through the Worker).
// Old site tabs (main 505e7b1) also wrote the order from the browser; that write is ignored by their code and the order
// is saved by Worker v1 — so these rules do not lose their orders. Their old success page loses the details read.
// Everything else is byte-for-byte firestore.rules.on-delivery.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function rolesDoc() {
      return /databases/$(database)/documents/config/roles;
    }

    function ownerUid() {
      return exists(rolesDoc()) ? get(rolesDoc()).data.ownerUid : null;
    }

    function isOwner() {
      return signedIn() && ownerUid() != null && request.auth.uid == ownerUid();
    }

    function isAdmin() {
      return signedIn() && (
        (ownerUid() != null && request.auth.uid == ownerUid()) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ✅ المالك فقط يتحكم بالأدمنز
    match /admins/{uid} {
      // an admin can read their OWN entry (the dashboard checks it instead of trusting users/{uid}.role)
      allow read: if isOwner() || isSelf(uid);
      allow create, update, delete: if isOwner();
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function isStr(v, max) {
      return v is string && v.size() <= max;
    }

    // ✅ المنتجات: قراءة للجميع، والتعديل للأدمن فقط. أرقام التقييم يحسبها الـ Worker من التقييمات المنشورة
    //    (POST /products/:id/ratings) — لم يعد أي زبون يستطيع كتابة متوسط النجوم أو عددها.
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ✅ الأقسام: قراءة للجميع، تعديل للأدمن/المالك فقط
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Worker-managed order (STOCK_POLICY=on_delivery): its status / stock effects belong to the Worker only
    function workerManaged() {
      // on_delivery (deducted on delivery) or on_acceptance (deducted when accepted from Telegram / automatically)
      return resource.data.get('inventory', {}).get('policy', '') in ['on_delivery', 'on_acceptance'];
    }
    function stillReserved() {
      return resource.data.get('inventory', {}).get('state', '') == 'reserved';
    }
    function ownsOrder() {
      return signedIn() && resource.data.get('userId', '') == request.auth.uid;
    }

   // ✅ الطلبات:
    match /orders/{id} {
      // 1. لا إنشاء من المتصفح أبدًا: الطلب يكتبه الـ Worker فقط (حساب خدمة لا تخضع لهذه القواعد)
      allow create: if false;

      // 2. القراءة: الأدمن، أو الزبون المسجّل صاحب الطلب. الضيف يتتبع طلبه عبر الـ Worker (رقم الطلب + رمز التتبع)
      allow get: if isAdmin() || ownsOrder();
      allow list: if isAdmin() || ownsOrder();

      // 3. طلبات الخادم (الخصم عند التسليم): الحالة والمخزون عبر الـ Worker فقط؛ الأدمن يستطيع تعليمها كمقروءة
      allow update: if isAdmin() && (
        !workerManaged()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByAdmin', 'updatedAt'])
      );
      // 4. حذف طلب خادم محجوز ممنوع (ألغِه أولًا ليُفك الحجز)
      allow delete: if isOwner() && !(workerManaged() && stillReserved());
    }

    // ✅ التقييمات: عامة للقراءة، بلا بريد إلكتروني. تقييم واحد لكل زبون لكل منتج (معرّف المستند = productId_uid)،
    //    محتوى مُتحقق منه، والإعجاب يغيّر إعجاب صاحبه فقط. الإخفاء والرد والحذف للأدمن.
    function reviewKeys() {
      return ['productId', 'userId', 'userName', 'rating', 'comment', 'status',
              'likesCount', 'likesBy', 'adminReply', 'createdAt', 'updatedAt'];
    }
    function validRating(v) {
      return v is int && v >= 1 && v <= 5;
    }
    match /reviews/{id} {
      allow read: if true;

      allow create: if signedIn()
        && id == request.resource.data.productId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(reviewKeys())
        && request.resource.data.userId == request.auth.uid
        && isStr(request.resource.data.productId, 120)
        && validRating(request.resource.data.rating)
        && isStr(request.resource.data.get('comment', ''), 2000)
        && isStr(request.resource.data.get('userName', ''), 80)
        && request.resource.data.get('status', 'published') == 'published'
        && request.resource.data.get('likesCount', 0) == 0
        && request.resource.data.get('likesBy', {}) == {}
        && request.resource.data.get('adminReply', null) == null;

      allow delete: if isAdmin();

      allow update: if isAdmin()
        || (signedIn()
            && resource.data.userId == request.auth.uid
            && changed().hasOnly(['rating', 'comment', 'userName', 'userEmail', 'updatedAt'])
            // userEmail may only be REMOVED (old reviews), never written or changed
            && (!('userEmail' in changed()) || !('userEmail' in request.resource.data))
            && validRating(request.resource.data.rating)
            && isStr(request.resource.data.get('comment', ''), 2000)
            && isStr(request.resource.data.get('userName', ''), 80))
        || (signedIn()
            && changed().hasOnly(['likesBy', 'likesCount', 'updatedAt'])
            && request.resource.data.likesBy is map
            && request.resource.data.likesBy.diff(resource.data.get('likesBy', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.likesCount == request.resource.data.likesBy.size());
    }

    // ✅ users: لا يستطيع المستخدم منح نفسه دورًا (role) أو تغيير معرّفه — صلاحية الأدمن من config/roles و admins فقط
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin() || (
        isSelf(uid)
        && request.resource.data.get('role', 'customer') == 'customer'
        && request.resource.data.get('id', uid) == uid);
      allow update: if isAdmin() || (isSelf(uid) && !changed().hasAny(['role', 'id']));
      allow delete: if isOwner();
    }

    // ✅ config:
    match /config/{doc} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // stockReservations/{productId} and orderLedger/{orderId}: intentionally NO match — every browser read and
    // write is denied; only the order Worker (service account) reads and writes them.
  }
}
