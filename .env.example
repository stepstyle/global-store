# Local development ONLY — copy to .env.development.local (git-ignored via *.local).
# `npm run dev` refuses to start unless these select the Firebase Emulator with a demo- project.
# Production builds (Vercel) do NOT need any of these variables: they keep the inline production config.
# Never put real keys, production identifiers, dairsharaf.com or a *.workers.dev URL in this file.

VITE_FIREBASE_TARGET=emulator
VITE_FIREBASE_PROJECT_ID=demo-dairsharaf-dev
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8088
VITE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional: a LOCAL order Worker (`wrangler dev --local`). Leave empty to skip the Worker call.
VITE_WORKER_URL=
