{
  "name": "anta-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators:dev": "firebase emulators:start --only firestore,auth --project demo-dairsharaf-dev --config firebase/dev-emulator.firebase.json",
    "test:firebase-guard": "node --test tools/firebase-guard.test.mjs",
    "test:order-submit": "node --test tests/unit/orderSubmit.test.mjs",
    "test:cart-storage": "node --test tests/unit/cartStorage.test.mjs",
    "test:order-limits": "node --test tests/unit/orderLimits.test.mjs",
    "test:attempt-recovery": "node --test tests/unit/attemptRecovery.test.mjs",
    "test:toast-queue": "node --test tests/unit/toastQueue.test.mjs",
    "test:dev-rules": "firebase emulators:exec --only firestore,auth --project demo-dairsharaf-dev --config firebase/dev-emulator.firebase.json \"node --test tools/dev-emulator.rules.test.mjs\""
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "@google/generative-ai": "^0.21.0",
    "firebase": "^12.10.0",
    "lucide-react": "^0.556.0",
    "papaparse": "^5.4.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-phone-number-input": "^3.4.16",
    "react-router-dom": "^7.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.14",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.0.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
